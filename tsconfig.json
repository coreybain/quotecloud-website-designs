{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "v*/**/*.ts", "travel/**/*.ts", "telco/**/*.ts", "esign/**/*.ts", "quoting/**/*.ts", "docgen/**/*.ts", "blocks/**/*.ts", "canvas/**/*.ts", "collab/**/*.ts", "proposal/**/*.ts", "cpq/**/*.ts", "ai-coworker/**/*.ts", "document-creation/**/*.ts", "image-editor/**/*.ts", "demo/**/*.ts", "vite.config.ts"]
}
